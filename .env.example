# Campaign War Room AI / NOCTUA — environment configuration
# Copy this file to backend/.env and fill in the values.
#
# Only a handful of vars are required to run (LLM_PROVIDER + one API key).
# Everything marked "optional" has a working default baked into the code —
# the values shown after the `=` ARE those defaults, so you only need to
# uncomment + change one if you want different behavior. Secrets are left
# blank on purpose; never commit real keys.
#
# The app technically runs without any API key (using a mock LLM), but every
# article will then be scored as "irrelevant" and the UI will look empty.
# You almost certainly want to configure Groq below.

# ══════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS
# ══════════════════════════════════════════════════════════════════════════
# Recommended: groq (free tier, fast, no credit card required).
# Sign up at https://console.groq.com and create an API key.
#
# Options: groq | openai | anthropic | mock
LLM_PROVIDER=groq

# Groq — used when LLM_PROVIDER=groq (and as part of the fallback chain).
# Add extra free-tier keys (each needs its own account at console.groq.com)
# for more daily quota; the provider round-robins across them.
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: use a cheaper/faster model for the high-volume ingestion-scoring
# path while keeping GROQ_MODEL for everything else. Empty = use GROQ_MODEL.
# GROQ_INGESTION_MODEL=

# Google Gemini — always used as a fallback regardless of LLM_PROVIDER.
# Add extra keys for more daily quota (each needs its own Google account at
# aistudio.google.com).
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-2.5-flash

# Cerebras — optional additional provider in the fallback chain.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# OpenAI — only used if LLM_PROVIDER=openai, PLUS it powers the "judge"
# provider used for prose/judgment work (briefing, variant naming, frame
# reclassification) regardless of LLM_PROVIDER. Leave the key blank to fall
# back to Groq for those too.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — only used if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Per-task model overrides (cost control) ───────────────────────────────
# These let you spend more on the few calls that write prose and less on the
# bulk scoring. All optional; defaults shown.
# OPENAI_JUDGE_MODEL=gpt-4o-mini          # frame reclassification, judgments
# OPENAI_BRIEFING_MODEL=gpt-4o            # morning briefing memo (prose)
# OPENAI_BRIEFING_TEMPERATURE=0.3
# OPENAI_RESCORE_MODEL=                    # empty = use the judge model
# OPENAI_TOPIC_LABEL_MODEL=gpt-4o-mini    # topic/cluster labeling

# ── Extraction verifier ───────────────────────────────────────────────────
# Second-pass check that guards against hallucinated extractions.
# EXTRACT_VERIFIER_ENABLED=true
# EXTRACT_VERIFIER_FAIL_OPEN=true          # on verifier error, keep the extraction
# EXTRACT_VERIFIER_MODEL=gpt-4o-mini

# ── LLM exhaustion backoff ────────────────────────────────────────────────
# When every provider is rate-limited, ingestion waits up to this long for a
# key to free up before giving up on the batch (seconds).
# LLM_EXHAUSTED_MAX_WAIT_SECONDS=1800

# ══════════════════════════════════════════════════════════════════════════
# SEARCH PROVIDER
# ══════════════════════════════════════════════════════════════════════════
# Options: mock | tavily
SEARCH_PROVIDER=mock
# Tavily — round-robin across multiple free-tier keys (each account is 1000
# credits/month). Add extras at TAVILY_API_KEY_2, _3, ... — same rotation
# pattern as GROQ_API_KEY_N. Provider quarantines any key returning
# 401/402/429/432 (monthly-quota-exhausted) until process restart.
# TAVILY_API_KEY=
# TAVILY_API_KEY_2=
# TAVILY_API_KEY_3=
# Search result cache (cuts repeat-query cost). Defaults shown.
# SEARCH_CACHE_TTL_DAYS=7
# SEARCH_CACHE_DISABLED=                   # set to 1 to disable caching

# ══════════════════════════════════════════════════════════════════════════
# INGESTION SCHEDULING & SOURCES
# ══════════════════════════════════════════════════════════════════════════
RSS_AUTO_INGEST_ENABLED=true
RSS_AUTO_INGEST_INTERVAL_MINUTES=30

# Social ingestion toggles (all optional; defaults shown).
# BLUESKY_FIREHOSE_ENABLED=true
# MASTODON_ENABLED=true
# MASTODON_INSTANCES=                      # comma-separated; empty = built-in list
# MASTODON_EXTRA_TAGS=                     # comma-separated extra hashtags
# REDDIT_COMMENTS_ENABLED=true
# REDDIT_SUBREDDITS=                       # comma-separated; empty = built-in list
# REDDIT_EXTRA_TERMS=                      # comma-separated extra search terms
# TAVILY_REDDIT_INTERVAL_HOURS=4
# SOCIAL_HANDLE_MONITORS_ENABLED=false     # per-handle X/Twitter monitors
# NITTER_INSTANCES=                        # comma-separated Nitter mirrors
# RSSHUB_BASE=https://rsshub.app

# FEC campaign-finance monitor. DEMO_KEY works but is heavily rate-limited;
# get a real key at https://api.open.fec.gov/developers/
# FEC_API_KEY=DEMO_KEY

# ══════════════════════════════════════════════════════════════════════════
# EMBEDDINGS
# ══════════════════════════════════════════════════════════════════════════
# Embeddings power variant clustering and semantic search.
# EMBED_USE_GEMINI=                        # set to 1 to use Gemini instead of OpenAI
# GOOGLE_APPLICATION_CREDENTIALS=          # path to a GCP service-account JSON

# ══════════════════════════════════════════════════════════════════════════
# INTERACTIVE API DOCS
# ══════════════════════════════════════════════════════════════════════════
# Swagger UI (/docs), ReDoc (/redoc), and the OpenAPI schema (/openapi.json)
# are DISABLED by default — they list every endpoint and schema, which is
# recon surface we don't want exposed through the public tunnel. Set to true
# only for local debugging when you want to browse the API interactively.
# EXPOSE_API_DOCS=false

# ══════════════════════════════════════════════════════════════════════════
# FRIEND-SHARE ACCESS CODES
# ══════════════════════════════════════════════════════════════════════════
# Turn the app into a private preview before you tunnel it to the internet.
# When ACCESS_CODES is empty (or unset), the app runs without auth and shows
# a "Guest" profile bubble. The moment you add any code here, every /api/*
# request requires a valid X-Access-Code header — friends without a code
# get bounced to the /login page.
#
# Format: semicolon-separated entries, each "code:Display Name" with an
# optional ":admin" suffix that grants admin powers (visibility of the
# per-article relevance bucket badge; running race-select / campaign init).
# Initials and a profile-bubble color are auto-derived from the name.
#
# ACCESS_CODES=alice-7m4q:Alice Smith;bob-9k2x:Bob Jones;theo-2x8p:Theo Capeilleres:admin
#
# Tips:
# - Pick codes that are easy to share verbally but not guessable (mix of
#   letters and digits, ~8+ chars). They're shared secrets, not passwords.
# - One code per friend so you can tell who's logged in (their initials show
#   in the top-right bubble) and revoke just that friend later by removing
#   their line.
# - Restart the backend after changing this — codes are read once at startup.

# ══════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════
# Production runs on Postgres 15 (cutover completed 2026-05-29). Set
# DATABASE_URL to your Postgres connection string. If DATABASE_URL is unset,
# the code falls back to a local SQLite file (backend/war_room.db) — fine for
# a first run or throwaway experiments, but NOT what the live app uses.
#
# Local Postgres 15 with the `noctua` database:
# DATABASE_URL=postgresql+psycopg://theo@localhost:5432/noctua
#
# Managed host (Neon/Supabase/RDS) — the host gives you a URL like:
# DATABASE_URL=postgresql+psycopg://user:pass@host.region.neon.tech/noctua?sslmode=require
#
# Tip: for ad-hoc ingestion experiments, point at a scratch DB instead of
# the live one, e.g. DATABASE_URL=postgresql+psycopg://theo@localhost:5432/noctua_scratch

# ══════════════════════════════════════════════════════════════════════════
# ADVANCED TUNING (you almost never need to touch these)
# ══════════════════════════════════════════════════════════════════════════
# Story-cluster dedup. Two articles cluster together when titles are similar
# AND published within the window.
# CLUSTER_WINDOW_DAYS=30
# CLUSTER_PUBLISHED_CLOSE_DAYS=14
# CLUSTER_SIMHASH_HAMMING_MAX=6
# CLUSTER_TITLE_JACCARD_MIN=0.65
# CLUSTER_RETRIGGER_DORMANT_DAYS=30
# CLUSTER_RETRIGGER_SIZE_FALLBACK=15,40

# Fragmented-cluster merge job heuristics.
# MERGE_MAX_LENGTH_RATIO=10
# MERGE_REQUIRE_NUMBER_MATCH=1
# MERGE_RULE2_HAMMING_MAX=8
# MERGE_RULE2_JACCARD_MIN=0.92
# MERGE_RULE3_JACCARD_MIN=0.65

# Relevance prefilter: cheap pre-LLM gate; score below this is dropped before
# the expensive scoring call.
# PREFILTER_THRESHOLD=15

# Rematch job (re-runs frame matching from cached extractions).
# REMATCH_PARALLEL_WORKERS=8
# REMATCH_DELAY_SECONDS=0.1

# Rescore job provider controls.
# RESCORE_SKIP_PROBE=                       # set to 1 to skip the pre-rescore probe
# RESCORE_SKIP_PROVIDERS=                   # comma-separated providers to skip

# Sanity keyword list override (relevance heuristics). Comma-separated.
# SANITY_KWS=
