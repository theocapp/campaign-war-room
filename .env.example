# Campaign War Room AI — environment configuration
# Copy to .env and fill in values you want to use.
# The app runs fully with LLM_PROVIDER=mock (no API keys needed).

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic
# Default: mock
LLM_PROVIDER=mock

# OpenAI — used when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — used when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
